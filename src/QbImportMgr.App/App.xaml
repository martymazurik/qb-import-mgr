<Application x:Class="QbImportMgr.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:QbImportMgr.App.Views"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <v:InverseBoolConverter x:Key="Not" />
    <v:InverseBoolToVisibilityConverter x:Key="NotToVis" />
    <v:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

    <SolidColorBrush x:Key="MutedBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D9DCE1" />
    <SolidColorBrush x:Key="OkBrush" Color="#1B7F3A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="DupBrush" Color="#FFF4E0" />

    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="0,2,8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Value" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="MinWidth" Value="70" />
    </Style>
  </Application.Resources>
</Application>
