<Window x:Class="QbImportMgr.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Ready transactions to IIF" Width="760" Height="560" MinHeight="360" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Padding="10" Margin="0,0,0,10" Background="#FFF3CD" BorderBrush="#E8C27A" BorderThickness="1" CornerRadius="4"
            Visibility="{Binding IsFirstExport, Converter={StaticResource BoolToVis}}">
      <TextBlock TextWrapping="Wrap">
        <Run FontWeight="SemiBold" Text="First import into QuickBooks." />
        <Run Text="Before importing this IIF, make a backup in QuickBooks: File > Back Up Company > Create Local Backup. IIF imports cannot be undone in QuickBooks." />
      </TextBlock>
    </Border>

    <TextBlock DockPanel.Dock="Top" Text="{Binding TotalText}" FontSize="15" FontWeight="SemiBold" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding ClearText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,8" />

    <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="None" MaxHeight="170" Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="*" />
        <DataGridTextColumn Header="QuickBooks account" Binding="{Binding QbAccount, TargetNullValue='(not mapped)'}" Width="*" />
        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70" />
        <DataGridTextColumn Header="Net" Binding="{Binding Net}" Width="120">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="HorizontalAlignment" Value="Right" />
              <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>

    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Export" IsDefault="True" Command="{Binding ExportCommand}" />
      <Button Content="Open IIF folder" Command="{Binding OpenIifFolderCommand}" />
      <Button Content="Close" IsCancel="True" Command="{Binding CloseCommand}" />
    </WrapPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ResultText}" TextWrapping="Wrap" Foreground="{StaticResource OkBrush}"
               Visibility="{Binding ResultText, Converter={StaticResource EmptyToCollapsed}}" Margin="0,8,0,0" />

    <StackPanel>
      <TextBlock Text="{Binding ErrorSummary}" Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"
                 Visibility="{Binding ErrorSummary, Converter={StaticResource EmptyToCollapsed}}" />
      <TextBlock Text="No problems found." Foreground="{StaticResource OkBrush}"
                 Visibility="{Binding HasIssues, Converter={StaticResource NotToVis}}" />
      <ListBox ItemsSource="{Binding Issues}" MaxHeight="220" BorderThickness="0"
               Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock TextWrapping="Wrap">
              <Run Text="{Binding Severity, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
  </DockPanel>
</Window>
