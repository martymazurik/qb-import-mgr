<Window x:Class="QbImportMgr.App.Views.ChooseAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Which account?" Width="460" SizeToContent="Height" FontSize="13" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="14">
    <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
    <ListBox x:Name="AccountList" Height="160" DisplayMemberPath="Label" MouseDoubleClick="List_MouseDoubleClick" />
    <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" IsDefault="True" Click="Ok_Click" />
      <Button Content="Cancel" IsCancel="True" />
    </WrapPanel>
  </StackPanel>
</Window>
