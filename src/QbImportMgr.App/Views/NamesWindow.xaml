<Window x:Class="QbImportMgr.App.Views.NamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickBooks names" Width="640" Height="560" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
      <TextBox Width="220" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox Content="Customers only" IsChecked="{Binding CustomersOnly}" VerticalAlignment="Center" Margin="12,0,0,0" />
    </WrapPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
    </DockPanel>
    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F2"
              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Invoiced" Width="70" SortMemberPath="IsInvoiced">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsInvoiced, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Name" Width="*" IsReadOnly="True" Binding="{Binding Display}" />
        <DataGridTextColumn Header="Type" Width="100" IsReadOnly="True" Binding="{Binding Type}" />
        <DataGridCheckBoxColumn Header="Active" Width="60" IsReadOnly="True" Binding="{Binding IsActive, Mode=OneWay}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
