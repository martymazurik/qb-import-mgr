<Window x:Class="QbImportMgr.App.Views.PickMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick the QuickBooks entry" Width="900" Height="380" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontWeight="SemiBold" Margin="0,0,0,8" />
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Pick" IsDefault="True" Click="Pick_Click" />
      <Button Content="Cancel" IsCancel="True" />
    </WrapPanel>
    <DataGrid ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F2"
              MouseDoubleClick="Grid_MouseDoubleClick">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Date" Width="90" Binding="{Binding Date}" />
        <DataGridTextColumn Header="Type" Width="110" Binding="{Binding Type}" />
        <DataGridTextColumn Header="Num" Width="70" Binding="{Binding Num}" />
        <DataGridTextColumn Header="Name" Width="150" Binding="{Binding Name}" />
        <DataGridTextColumn Header="Memo" Width="*" Binding="{Binding Memo}" />
        <DataGridTextColumn Header="Split" Width="140" Binding="{Binding Split}" />
        <DataGridTextColumn Header="Why" Width="110" Binding="{Binding Why}" />
        <DataGridTextColumn Header="Name match" Width="80" Binding="{Binding Similarity}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
