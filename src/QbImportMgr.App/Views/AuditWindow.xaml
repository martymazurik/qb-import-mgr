<Window x:Class="QbImportMgr.App.Views.AuditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit log" Width="1100" Height="620" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <DockPanel Margin="14">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
      <DatePicker SelectedDate="{Binding From}" Width="130" />
      <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,6,0" />
      <DatePicker SelectedDate="{Binding To}" Width="130" />
      <TextBlock Text="Entity" VerticalAlignment="Center" Margin="16,0,6,0" />
      <ComboBox Width="140" ItemsSource="{Binding Entities}" SelectedItem="{Binding Entity}" />
      <TextBlock Text="Action" VerticalAlignment="Center" Margin="16,0,6,0" />
      <ComboBox Width="170" ItemsSource="{Binding Actions}" SelectedItem="{Binding Action}" />
      <Button Content="Search" IsDefault="True" Margin="16,0,0,0" Command="{Binding SearchCommand}" />
    </WrapPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" />
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
    </DockPanel>
    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF0F2"
              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="When" Width="140" Binding="{Binding When}" />
        <DataGridTextColumn Header="Entity" Width="110" Binding="{Binding Entity}" />
        <DataGridTextColumn Header="Id" Width="60" Binding="{Binding EntityId}" />
        <DataGridTextColumn Header="Action" Width="150" Binding="{Binding Action}" />
        <DataGridTextColumn Header="Detail" Width="*" Binding="{Binding Detail}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
